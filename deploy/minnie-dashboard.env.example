# Start in demo mode. Change to live only after capturing and mapping real sensors.
DASHBOARD_MODE=demo
DASHBOARD_API_PORT=8080
DASHBOARD_DB=/var/lib/minnie-dashboard/dashboard.db
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_PROFILE=/etc/minnie-dashboard/dashboard-profile.json
RVW_POLL_SECONDS=60
STALE_AFTER_SECONDS=150

# Required for live mode. Keep this file on the Pi and out of Git.
RVW_ID=
# Prefer local mode when the Pi and RVM3 share a trusted LAN.
# local: RVW_BASE_URL is the RVM3's direct http:// hostname or IP and credentials are not used.
# gateway: RVW_BASE_URL is https://access.rvwhisper.com and credentials are required.
RVW_ACCESS_MODE=local
RVW_BASE_URL=
# Usually blank for direct RVM3 access. Gateway mode defaults to /<RVW_ID>.
RVW_SYSTEM_PATH=
RVW_USERNAME=
RVW_PASSWORD=
SENSOR_MAP=/etc/minnie-dashboard/sensor-map.json
RVW_CAPTURE_DIR=/var/lib/minnie-dashboard/captures
