[Unit]
Description=Minnie Winnie dashboard collector and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rvdashboard
Group=rvdashboard
WorkingDirectory=/opt/minnie-dashboard/current/backend
EnvironmentFile=/etc/minnie-dashboard/dashboard.env
ExecStart=/opt/minnie-dashboard/current/backend/.venv/bin/rv-dashboard
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minnie-dashboard

[Install]
WantedBy=multi-user.target
