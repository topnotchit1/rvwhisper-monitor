[Unit]
Description=Minnie Winnie touchscreen web UI
After=network-online.target minnie-dashboard-api.service
Wants=network-online.target

[Service]
Type=simple
User=rvdashboard
Group=rvdashboard
WorkingDirectory=/opt/minnie-dashboard/current
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:8080
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
