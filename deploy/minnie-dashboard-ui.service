[Unit]
Description=Minnie Winnie touchscreen web UI
After=network.target minnie-dashboard-api.service

[Service]
Type=simple
User=rvdashboard
WorkingDirectory=/opt/minnie-dashboard
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:8080
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
