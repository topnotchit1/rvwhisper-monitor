DASHBOARD_MODE=demo
DASHBOARD_API_PORT=8080
DASHBOARD_DB=./data/dashboard.db
DASHBOARD_ORIGINS=http://localhost:3000
DASHBOARD_PROFILE=./config/dashboard-profile.example.json
RVW_POLL_SECONDS=60
STALE_AFTER_SECONDS=150

# Required only when DASHBOARD_MODE=live
RVW_ID=<rvm-id>
# gateway: authenticated access through access.rvwhisper.com
# local: direct HTTP access to the RVM3 on the same trusted LAN
RVW_ACCESS_MODE=gateway
RVW_BASE_URL=https://access.rvwhisper.com
# Leave blank for the normal local RVM3 root page. Gateway mode defaults to /<RVW_ID>.
RVW_SYSTEM_PATH=
# Required only when RVW_ACCESS_MODE=gateway
RVW_USERNAME=
RVW_PASSWORD=
SENSOR_MAP=./config/sensor-map.json
